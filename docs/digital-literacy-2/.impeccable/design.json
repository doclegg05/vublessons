      "html": "<button class=\"ds-primary\" type=\"button\">Start lesson</button>",
      "css": ".ds-primary{font-family:'Segoe UI',Tahoma,Geneva,Verdana,sans-serif;font-size:18px;line-height:1.8;font-weight:700;display:inline-flex;align-items:center;justify-content:center;gap:.5em;min-height:48px;padding:.55em 1em;border:2px solid #1b365d;border-radius:8px;cursor:pointer;background:#1b365d;color:white}.ds-primary:hover{background:#2c4a7c}.ds-primary:focus-visible{outline:4px solid #a65a00;outline-offset:4px;}.ds-primary:active{transform:translateY(1px)}.ds-primary:disabled{opacity:.55;cursor:default}",
